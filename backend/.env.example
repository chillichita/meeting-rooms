# API port
PORT=8080

# Secret for signing JWT session cookies (used from MR-6)
JWT_SECRET=dev-secret-change-me

# SQLite database file path, relative to backend/ (used from MR-4)
DB_PATH=./data/meeting-rooms.db

# Frontend origin for the email-verify redirect (used from MR-22)
FRONTEND_URL=http://localhost:3000

# How many minutes before a booking's end the author is notified when the
# next slot in the room is taken (used from MR-23)
NOTIFY_BEFORE_MINUTES=10
