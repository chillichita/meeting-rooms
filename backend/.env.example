# API port
PORT=8080

# Secret for signing JWT session cookies
JWT_SECRET=dev-secret-change-me

# SQLite database file path, relative to backend/
DB_PATH=./data/meeting-rooms.db

# Frontend origin for the email-verify redirect
FRONTEND_URL=http://localhost:3000

# How many minutes before a booking's end the author is notified when the
# next slot in the room is taken
NOTIFY_BEFORE_MINUTES=10
